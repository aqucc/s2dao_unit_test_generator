<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE components PUBLIC "-//SEASAR2.1//DTD S2Container//EN"
	"http://www.seasar.org/dtd/components21.dtd">
<!--
  S2JDBC 用 dicon 雛形(jdbc.dicon 相当)。

  ステップ3(S2JDBC Service 対応)で生成したテストは、S2TestContext#getComponent(Class)
  でコンポーネントを取得する(内部で container.getComponent(具象Serviceクラス) を呼ぶだけ)。
  したがって dicon 側では、
    (1) JdbcManager を組み立て(DataSource + Dialect + SqlFileRepository)、
    (2) Service を「クラスをキーに」取得できるよう自動登録(ComponentAutoRegister)する
  だけでよい(Service 個別の component 宣言は不要)。

  ※ 実行には S2JDBC ランタイム(s2jdbc.jar 等)が classpath に必要。本リポジトリの
    verification/lib には s2jdbc は同梱していないため、利用者環境で jar を用意すること。
    クラス名(org.seasar.extension.jdbc.manager.JdbcManagerImpl 等)は S2JDBC の版に合わせる。
-->
<components namespace="jdbc">

	<!-- ===== トランザクション ===== -->
	<component class="org.seasar.extension.jta.TransactionManagerImpl"/>
	<component class="org.seasar.extension.jta.UserTransactionImpl"/>
	<component name="requiredTx" class="org.seasar.extension.tx.RequiredInterceptor"/>

	<!-- ===== DataSource(H2 Oracic 互換モード。旧環境相当の検証用) ===== -->
	<component name="xaDataSource" class="org.seasar.extension.dbcp.impl.XADataSourceImpl">
		<property name="driverClassName">"org.h2.Driver"</property>
		<property name="URL">"jdbc:h2:mem:s2jdbcgen;MODE=Oracle;DB_CLOSE_DELAY=-1"</property>
		<property name="user">"sa"</property>
		<property name="password">""</property>
	</component>
	<component name="connectionPool" class="org.seasar.extension.dbcp.impl.ConnectionPoolImpl">
		<property name="timeout">600</property>
		<property name="maxPoolSize">10</property>
		<property name="allowLocalTx">true</property>
		<destroyMethod name="close"/>
	</component>
	<component name="dataSource" class="org.seasar.extension.dbcp.impl.DataSourceImpl"/>

	<!-- ===== S2JDBC 本体 ===== -->
	<!-- Dialect は接続先 DB に合わせる(H2/Oracle 互換 → OracleDialect が無難) -->
	<component name="dialect" class="org.seasar.extension.jdbc.dialect.OracleDialect"/>
	<component name="sqlFileRepository"
		class="org.seasar.extension.jdbc.impl.NodeSqlFileRepositoryImpl"/>
	<component name="jdbcManager"
		class="org.seasar.extension.jdbc.manager.JdbcManagerImpl">
		<property name="dataSource">dataSource</property>
		<property name="dialect">dialect</property>
		<property name="sqlFileRepository">sqlFileRepository</property>
	</component>

	<!-- ===== Service 自動登録(パッケージ配下の *Service を component 化) ===== -->
	<component class="org.seasar.framework.container.autoregister.FileSystemComponentAutoRegister">
		<initMethod name="addClassPattern">
			<arg>"example.servicebase.service"</arg>
			<arg>".*Service"</arg>
		</initMethod>
	</component>

</components>
