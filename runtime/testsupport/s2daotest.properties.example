# =============================================================================
# 生成テストの実行時設定サンプル(S2TestContext が読み込む)
#
# 配置: classpath 直下 または カレントディレクトリに s2daotest.properties として置く。
#       別名にする場合はシステムプロパティ -Ds2daotest.config=<path> で指定する。
#
# エビデンス CSV の出力先はシステムプロパティ -Ds2daotest.evidence.dir=<dir> が最優先。
# =============================================================================

# --- 素の JDBC 接続(テストデータ投入・データセット取得用。DAO と同一 DB を指すこと) ---

# 旧環境相当 (H2 Oracle 互換モード) の例
jdbc.driver=org.h2.Driver
jdbc.url=jdbc:h2:mem:testdb;MODE=Oracle;DB_CLOSE_DELAY=-1
jdbc.user=sa
jdbc.password=

# 新環境 (PostgreSQL 16) の例
#jdbc.driver=org.postgresql.Driver
#jdbc.url=jdbc:postgresql://localhost:5432/s2daotest
#jdbc.user=s2daotest
#jdbc.password=s2daotest

# 実 Oracle11g の例(利用者実環境)
#jdbc.driver=oracle.jdbc.driver.OracleDriver
#jdbc.url=jdbc:oracle:thin:@localhost:1521:XE
#jdbc.user=TESTUSER
#jdbc.password=TESTUSER

# --- DB 方言: oracle | postgre | h2-oracle ---
dialect=h2-oracle

# --- S2Container の dicon(DAO 取得用)。datasource は上記 jdbc と同一 DB を指すこと ---
dicon=dao.dicon

# --- エビデンス CSV 出力先(既定 ./evidence)---
#evidence.dir=./evidence
